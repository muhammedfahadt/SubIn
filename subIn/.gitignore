# ============================================================
# SubIn — Root .gitignore
# Generated from subIn/gameon-project.md stack:
# backend/ (Python FastAPI + SQLAlchemy + PostGIS + Alembic + Redis + Pytest)
# frontend/ (Flutter Web + Riverpod + Dio + google_maps + build_runner)
# docker-compose.yml (Postgres/PostGIS + Redis + Backend + Nginx)
# ============================================================

# ---------- OS ----------
.DS_Store
Thumbs.db
Desktop.ini
*.lnk

# ---------- Git / Editors ----------
.git/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
.idea/
*.iml
*.ipr
*.iws
*.swp
*.swo
*~
.project
.classpath
.c9/
*.launch
.nbattrs

# ---------- Env / Secrets — NEVER commit ----------
# backend/app/config.py loads `.env` via pydantic-settings
.env
.env.*
!.env.example
!.env.sample
*.pem
*.key
*.p12
*.jks
secrets/
serviceAccount.json
google-services.json
GoogleService-Info.plist
firebase_options.dart

# ---------- Docker / Compose ----------
# DB data volume from docker-compose.yml `postgres_data:/var/lib/postgresql/data`
postgres_data/
data/db/
*.sql.dump
*.backup
docker-compose.override.yml

# ---------- Python / FastAPI Backend ----------
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
venv/
.venv/
env/
ENV/
backend/venv/
backend/.venv/
backend/env/
pip-wheel-metadata/
*.egg-info/
*.egg
.eggs/
dist/
build/
develop-eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-log.txt
pip-delete-this-directory.txt
.coverage
.coverage.*
coverage.xml
*.cover
htmlcov/
.pytest_cache/
backend/.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.hypothesis/
tox/
.nox/
pytestdebug.log

# Alembic — keep migrations, ignore pycache + local versions if autogenerated
backend/alembic/__pycache__/
backend/app/__pycache__/
backend/app/routers/__pycache__/

# Uvicorn / Gunicorn reload + logs
*.log
logs/
uvicorn.log

# Redis dump from local dev
dump.rdb

# ---------- Flutter Frontend ----------
# Standard Flutter ignores
frontend/.dart_tool/
frontend/.flutter-plugins
frontend/.flutter-plugins-dependencies
frontend/.packages
frontend/build/
frontend/.pub-cache/
frontend/.pub/
frontend/version
pubspec.lock
# Keep pubspec.yaml, ignore lock for libs? For apps keep lock — uncomment next line if you want to ignore:
# frontend/pubspec.lock

# Flutter generated — KEEP *.g.dart / *.freezed.dart in git (needed for models/event.dart etc.)
# Uncomment below ONLY if you want to regenerate always via build_runner:
# *.g.dart
# *.freezed.dart

# Flutter web build output + nginx serve stage (frontend/Dockerfile)
frontend/build/
frontend/.flutter_build/
# Dart incremental compiler cache — the 103MB blocker you hit
*.dill
*.track.dill
frontend/build/**

# Dart / Flutter test + coverage
frontend/coverage/
frontend/test/*.mocks.dart

# Android
frontend/android/.gradle/
frontend/android/captures/
frontend/android/gradlew
frontend/android/gradlew.bat
frontend/android/local.properties
frontend/android/**/generated/
frontend/android/app/build/
frontend/android/app/*.jks
frontend/android/key.properties
*.keystore

# iOS / macOS
frontend/ios/Flutter/Generated.xcconfig
frontend/ios/Flutter/flutter_export_environment.sh
frontend/ios/Pods/
frontend/ios/.symlinks/
frontend/ios/Flutter/App.framework
frontend/ios/Flutter/Flutter.framework
frontend/ios/Flutter/Flutter.podspec
frontend/macos/Flutter/GeneratedPluginRegistrant.swift
frontend/macos/Pods/
frontend/macos/**/xcuserdata/
*.xcuserdata/
*.xcworkspace/xcuserdata/
DerivedData/
*.hmap
*.ipa
*.dSYM.zip
*.dSYM/

# Windows / Linux Flutter desktop
frontend/windows/flutter/generated_plugin_registrant.cc
frontend/linux/flutter/generated_plugin_registrant.cc

# Chrome device tool cache seen in your repo (frontend/.dart_tool/chrome-device/)
frontend/.dart_tool/chrome-device/

# Assets that should NOT be committed if local only
# frontend/assets/images/*.png — keep if you have committed assets, ignore user uploads
frontend/assets/cache/

# Sentry / Talker debug dumps
sentry-debug-meta.properties

# ---------- Node (for nginx.conf tooling / frontend web tooling if any) ----------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
frontend/web/node_modules/

# ---------- Misc ----------
*.tmp
*.temp
*.bak
*.orig
.cache/
tmp/
temp/
